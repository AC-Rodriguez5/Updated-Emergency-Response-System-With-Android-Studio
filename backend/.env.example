# Backend Environment Variables
# Copy to .env and fill in. Do NOT commit .env with real values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/tanzalert?retryWrites=true&w=majority

# JWT — both must be 32+ chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-32-or-more-random-chars-xxxxxxxx
JWT_REFRESH_SECRET=replace-with-32-or-more-random-chars-yyyyyyyy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated whitelist
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Body parser size limit
BODY_LIMIT=1mb

# Admin seed (created/synced on backend boot; dev re-syncs every boot, prod only on first boot)
ADMIN_EMAIL=admin@tanzalert.local
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=TanzAlert Admin
