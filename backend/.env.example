# Copy this file to backend/.env and fill in real values there.
#
# .env is gitignored; THIS file is committed, so every value below is a
# placeholder on purpose. An earlier version of this file carried the working
# Atlas URI, JWT secrets and admin password, which published them to anyone who
# could read the repository. Never paste a live value here again — if a secret
# reaches this file, treat it as burned and rotate it at the source.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string for this deployment's own database user.
# Give that user access to this database only, and keep the Atlas IP access
# list as narrow as the deployment allows.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Token signing. Minimum 32 characters each, different from one another, and
# never shared between environments. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating these invalidates every issued token, so everyone signs in again.
JWT_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated whitelist
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Body parser size limit
BODY_LIMIT=1mb

# Dispatch watchdog (seconds)
# ACK: how long a dispatcher's assignment waits for the responder to answer
# before it returns to the pending pool. OVERDUE: how long an incident may sit
# with nobody accepting it before dispatch is told. SWEEP: how often both are checked.
DISPATCH_ACK_SECONDS=90
DISPATCH_OVERDUE_SECONDS=120
DISPATCH_SWEEP_SECONDS=20

# How close a responder must be to the scene before the system says so by
# itself (emergency.responder_nearby). Matches the responder app's own radius.
RESPONDER_NEARBY_METERS=200

# How long a resident's GPS fix is kept before the retention sweep erases it.
#
# The consent form every resident agrees to at registration says one year, so
# this is the number that promise is made of. Changing it changes what the app
# tells people — keep the two in step (consent_content.dart).
#
# Only fixes expire. What outlives them: the incident record itself, its
# timeline, and the barangay it happened in, which is what the annual figures
# are counted by. Responder trails run on the same clock as residents'.
#
# An incident still open past the window is left alone and logged instead: an
# open incident is live dispatch, and its position may be the only thing telling
# a responder where to go.
#
# 0 switches erasure off and warns at boot, because at that point the app is
# promising something this deployment does not do.
LOCATION_RETENTION_DAYS=365
# How long a completed transport booking keeps its personal contents.
#
# Its own window, because it is a different kind of record from a GPS fix: a
# named patient, their contact and their medical condition, often about somebody
# who is not the account holder. Set it deliberately — 365 here only matches
# the location window so that switching this on changes nothing by surprise.
#
# Bookings are redacted, not deleted. What survives is the skeleton MDRRMO
# counts its ambulance work by: type, status, dates, the unit that went, the
# barangay and the timeline. What goes is the patient block, the accompanying
# person, both map points, the notes, the hospital names, and the personal half
# of the sender snapshot. The snapshot's file ids are dropped but never
# followed: they point at the account's own registration documents.
#
# A booking is aged from when it was last touched, not from when it was typed,
# so one booked in January for a March transport ages from March. Anything not
# yet finished is never touched. 0 switches this off without affecting location.
TRANSPORT_RETENTION_DAYS=365

# How often the sweep runs. It also runs once at boot.
RETENTION_SWEEP_HOURS=12
# Counts what the sweep would erase, and erases nothing. Worth one boot with
# this on before the first real run: erasure cannot be undone, and a deployment
# that has been collecting for longer than the window has a backlog waiting.
RETENTION_DRY_RUN=false

# Human check on the resident app's sign-in and registration.
#
# builtin (default) — this backend draws the challenge and marks the answer
#   itself. No account, no keys, no internet, nothing to register. The app shows
#   the picture inline on the sign-in and registration forms. This is the only
#   option that works when the server answers on a LAN address, because no
#   hosted provider will issue keys for one.
# turnstile / hcaptcha / recaptcha — the hosted widget, rendered in a WebView
#   over the page this backend serves at GET /api/captcha. Needs the key pair
#   below AND the BACKEND's own hostname registered with the provider, since
#   that is the origin the WebView loads from. The site key is public; the
#   secret never leaves this server.
# none — no check at all.
#
# Responder and admin sign-ins are never challenged: they name their role and
# have no way to raise one.
CAPTCHA_PROVIDER=builtin
# Read only by the hosted providers; leave both empty for builtin.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# When a hosted provider's verifier is unreachable: true lets the request
# through and logs it, false refuses with 503. True by default — locking people
# out of an emergency system to stop a hypothetical bot is the worse failure.
# The builtin challenge is marked in this process, so it is never affected.
CAPTCHA_FAIL_OPEN=true

# Admin seed (created/synced on backend boot; dev re-syncs every boot, prod only on first boot).
# Use a long random password — in development this value is written over the
# admin account on every boot, so whatever is here IS the admin password.
ADMIN_EMAIL=admin@tanzalert.local
ADMIN_PASSWORD=replace-me-with-a-long-random-password
ADMIN_NAME=TanzAlert Admin
