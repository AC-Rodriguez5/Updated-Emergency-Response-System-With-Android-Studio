      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- mobileUser → Cloud Server -->
    <mxCell id="lnk1" value="HTTPS  (REST API + WebSocket)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2;fontSize=11;fontColor=#000000;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" source="N1" target="N3" parent="1">
