    <!-- ═══════════════════════════════════════════════════════════
         LEGEND + NOTES
    ═══════════════════════════════════════════════════════════ -->
    <mxCell id="leg" value="Legend:&#xa;━━━  Communication link (protocol labeled on arrow)&#xa;- - -   Internal component or config file&#xa;«hardware device»            Physical IoT device&#xa;«device»                        Mobile / desktop machine&#xa;«execution environment»    Cloud-hosted runtime&#xa;«database server»             Cloud-hosted data store&#xa;Bold border on BLE Module = IoT-connected component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;fontColor=#000000;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="40" y="1200" width="400" height="160" as="geometry" />
    </mxCell>

    <mxCell id="note" value="In plain English:&#xa;1. Citizen presses a button on the ESP32 BLE keychain (IoT device)&#xa;2. mobileUser Flutter app picks up the BLE signal, adds GPS + user profile, sends to server&#xa;3. Responders use the mobileResponder Flutter app to accept and resolve emergencies&#xa;4. MDRRMO admins use the Web Admin Dashboard to dispatch, monitor, and view BLE device management&#xa;5. Express server on Render handles all logic; data is stored in MongoDB Atlas&#xa;6. Socket.io pushes live updates to all connected clients instantly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;fontColor=#000000;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="500" y="1200" width="800" height="140" as="geometry" />
    </mxCell>

  </root>
