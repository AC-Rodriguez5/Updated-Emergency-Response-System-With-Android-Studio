{
  "name": "safealert-backend",
  "version": "2.0.0",
  "main": "src/server.ts",
  "description": "SafeAlert Emergency Response System Backend API with security improvements",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:load": "node --import tsx --test tests/load.test.ts",
    "migration:check": "tsx src/scripts/migrate.ts",
    "indexes:check": "tsx src/scripts/indexes.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.3",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "4.8",
    "supertest": "^7.2.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
