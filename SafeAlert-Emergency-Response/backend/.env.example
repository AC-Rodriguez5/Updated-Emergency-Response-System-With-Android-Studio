# Local development requires a MongoDB replica set for transactions.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/safealert?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-secret-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only after configuring Firebase Application Default Credentials.
FCM_ENABLED=false
# Set contracted/self-hosted providers; no shared public service is assumed.
# OVERPASS_URL=https://your-facilities-provider.example/api/interpreter
# ROUTING_URL=https://your-routing-provider.example
# Optional, one-time administrator provisioning; no default account is created.
# ADMIN_EMAIL=operations@example.org
# ADMIN_PASSWORD=generate-a-unique-password-at-least-12-characters
# TRUST_PROXY_HOPS=1
